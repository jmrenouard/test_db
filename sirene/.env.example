# Local ephemeral Docker PoC configuration for Sirene PostgreSQL 3NF ETL
# Copy to .env before customizing locally; never commit .env or real secrets.

POSTGRES_USER=sirene
POSTGRES_PASSWORD=pg_sirene_ephemeral
POSTGRES_DB=sirene
POSTGRES_IMAGE=postgres:18-bookworm
POSTGRES_HOST_PORT=15432
MM_NODE_A_PORT=15441
MM_NODE_B_PORT=15442

# Host-side connection string (inside Docker Compose, sirene-postgres:5432 is used)
DATABASE_URL=postgresql://sirene:pg_sirene_ephemeral@localhost:15432/sirene

# Pipeline & Watcher configuration
STAGING_DIR=./staging
BATCH_SIZE=50000
WATCHER_INTERVAL_SECONDS=3600
PREFERRED_FORMAT=parquet
LOG_LEVEL=INFO
